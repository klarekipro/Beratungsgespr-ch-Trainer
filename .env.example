# Template only. Never commit an actual key.
# The current experiment wrapper uses an environment variable or a masked prompt;
# it does not automatically load .env. No .env is created by workspace setup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Functional dashboard reads environment variables, not this file automatically.
# Use: python scripts/serve_dashboard.py --openai (masked interactive prompt).
TRAINER_MAX_TURNS=30
TRAINER_MAX_LIVE_ATTEMPTS=30
# One live turn now uses up to 3 API requests; this limit counts turn attempts.
# Optional: TRAINER_DATA_DIR=/absolute/private/path
# Optional Cyrillic font overrides: TRAINER_FONT_PATH / TRAINER_BOLD_FONT_PATH
